DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<senha-do-banco>
DB_NAME=postgres
PORT=3001

# Segredo para assinar os tokens de login (JWT). Gere um valor longo e aleatório.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<segredo-aleatorio>
# JWT_EXPIRES_IN=12h
# CORS_ORIGINS=https://seu-dominio.com

# Ambiente: em "production" o servidor se recusa a subir sem JWT_SECRET.
# NODE_ENV=production
# TLS do banco: DB_SSL=false só para banco local. Para validar o certificado do Supabase,
# cole o CA (PEM) em DB_CA, usando \n no lugar de quebras de linha.
# DB_SSL=false
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
