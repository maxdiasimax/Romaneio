ackend uses a privileged role."}, {"id": "multitenant_migration_001", "label": "migrations/001_multitenant.sql", "file_type": "concept", "source_file": "MULTITENANT.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "multitenant_supabase_schema", "label": "supabase_schema.sql (new DB)", "file_type": "concept", "source_file": "MULTITENANT.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "multitenant_create_tenant_script", "label": "scripts/create-tenant.js", "file_type": "code", "source_file": "MULTITENANT.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "multitenant_tenant_suspension", "label": "Tenant suspend/reactivate (tenants.active)", "file_type": "concept", "source_file": "MULTITENANT.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tenant management is done by script/SQL on purpose so no client Admin profile has power over other companies."}, {"id": "multitenant_global_unique_username", "label": "Globally unique username", "file_type": "concept", "source_file": "MULTITENANT.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows login without informing the company."}, {"id": "multitenant_tenant_isolation_test", "label": "tests/tenant-isolation.test.js", "file_type": "code", "source_file": "MULTITENANT.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "multitenant_deploy_order", "label": "Deploy order: backup, migrate, deploy code", "file_type": "rationale", "source_file": "MULTITENANT.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New code without migration gives 500 (tenants